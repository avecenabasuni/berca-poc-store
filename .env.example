# Datadog Agent Configuration
DD_API_KEY=
DD_SITE=datadoghq.com

# Medusa Storefront Publishable API Key
MEDUSA_PUBLISHABLE_KEY=

# Public URLs opened by users on the trusted Lab network. Replace the
# placeholders only in the VM's ignored .env file.
STOREFRONT_PUBLIC_URL=http://<VM_IP>:8000
MEDUSA_PUBLIC_URL=http://<VM_IP>:9000
