# Datadog Agent Configuration
DD_API_KEY=
DD_SITE=datadoghq.com

# Medusa Storefront Publishable API Key
MEDUSA_PUBLISHABLE_KEY=

# Public storefront URL opened by users. Browser API calls are proxied through
# this HTTPS origin; the Medusa container is reached only over the Docker network.
STOREFRONT_PUBLIC_URL=https://store.example.invalid
