FROM node:20-alpine AS build-arguments

ARG MEDUSA_PUBLIC_URL
ARG STOREFRONT_PUBLIC_URL
ARG MEDUSA_PUBLISHABLE_KEY

RUN test -n "$MEDUSA_PUBLIC_URL" \
  && test -n "$STOREFRONT_PUBLIC_URL" \
  && test -n "$MEDUSA_PUBLISHABLE_KEY"

FROM build-arguments AS dependencies

WORKDIR /server

RUN npm install pnpm@10.11.1 -g

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/backend/package.json ./apps/backend/
COPY apps/storefront/package.json ./apps/storefront/

RUN pnpm install --filter @dtc/storefront... --frozen-lockfile

FROM dependencies AS builder

ARG MEDUSA_PUBLIC_URL
ARG STOREFRONT_PUBLIC_URL
ARG MEDUSA_PUBLISHABLE_KEY

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV MEDUSA_BACKEND_URL_INTERNAL=http://medusa:9000
ENV NEXT_PUBLIC_MEDUSA_BACKEND_URL=$MEDUSA_PUBLIC_URL
ENV NEXT_PUBLIC_BASE_URL=$STOREFRONT_PUBLIC_URL
ENV NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=$MEDUSA_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_DEFAULT_REGION=id

COPY apps/storefront ./apps/storefront

RUN pnpm --dir apps/storefront build

FROM node:20-alpine AS runner

WORKDIR /server/apps/storefront

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV MEDUSA_BACKEND_URL_INTERNAL=http://medusa:9000

COPY --from=builder /server/node_modules /server/node_modules
COPY --from=builder /server/apps/storefront/node_modules ./node_modules
COPY --from=builder /server/apps/storefront/package.json ./package.json
COPY --from=builder /server/apps/storefront/next.config.js ./next.config.js
COPY --from=builder /server/apps/storefront/public ./public
COPY --from=builder /server/apps/storefront/.next ./.next

EXPOSE 8000

CMD ["./node_modules/.bin/next", "start", "-p", "8000"]
