# Source control and local development metadata
.git/
.github/
.ansible/
.vscode/
.DS_Store
skills/

# Dependencies and generated application output
node_modules/
**/node_modules/
.pnpm-store/
**/.pnpm-store/
.turbo/
**/.turbo/
**/.next/
**/.medusa/
**/out/
**/dist/
**/build/
**/coverage/
**/__pycache__/
**/*.py[cod]
**/*.tsbuildinfo

# Runtime secrets must never enter an image layer
.env
.env.*
**/.env
**/.env.*
!**/.env.example
!**/.env.template

# POC runtime state and synthetic filesystem content
docker/log-saturation/data/
docker/log-saturation/data/**
docker/demo-state/*
*.img
*.log

# Miscellaneous local output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.nyc_output/
