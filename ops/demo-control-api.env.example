DEMO_CONTROL_PROJECT_PATH=/absolute/path/to/berca-poc-store
DEMO_CONTROL_ENVIRONMENT=poc
DEMO_CONTROL_BIND=127.0.0.1
DEMO_CONTROL_PORT=18080
DEMO_CONTROL_TIMEOUT_SECONDS=240
DEMO_CONTROL_JOB_LOG_PATH=/var/log/berca-poc/demo-control-jobs.log
DEMO_CONTROL_JOB_LOG_MAX_BYTES=1048576
DEMO_CONTROL_JOB_LOG_BACKUP_COUNT=2
DEMO_CONTROL_FAULT_TOKEN=<REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_TOKEN>
DEMO_CONTROL_REMEDIATION_TOKEN=<REPLACE_WITH_DIFFERENT_RANDOM_32_PLUS_CHARACTER_TOKEN>
DEMO_SCALE_CONTROL_TOKEN=<REPLACE_WITH_THIRD_RANDOM_32_PLUS_CHARACTER_TOKEN>
DEMO_DEPLOYMENT_CONTROL_TOKEN=<REPLACE_WITH_FOURTH_RANDOM_32_PLUS_CHARACTER_TOKEN>

# Calibrated only on the Linux VM. This is the fixed request rate used by the
# autoscale-demo profile; it is never accepted from an API request.
AUTOSCALE_SPIKE_RATE=<CALIBRATED_INTEGER_BETWEEN_1_AND_240>
