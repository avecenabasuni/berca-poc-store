[Unit]
Description=Berca POC Demo Control API
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=@POC_PROJECT_PATH@
EnvironmentFile=/etc/berca-poc/demo-control-api.env
ExecStart=/usr/bin/python3 @POC_PROJECT_PATH@/tools/demo-control-api.py
LogsDirectory=berca-poc
LogsDirectoryMode=0700
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=multi-user.target
