[Unit]
Description=Berca POC Demo Control API
Requires=docker.service
After=network-online.target docker.service berca-poc-stack.service
Wants=network-online.target berca-poc-stack.service
ConditionPathExists=@POC_PROJECT_PATH@/tools/demo-control-api.py

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=@POC_PROJECT_PATH@
EnvironmentFile=/etc/berca-poc/demo-control-api.env
ExecStart=/usr/bin/python3 @POC_PROJECT_PATH@/tools/demo-control-api.py
LogsDirectory=berca-poc
LogsDirectoryMode=0700
Restart=always
RestartSec=2
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=multi-user.target
