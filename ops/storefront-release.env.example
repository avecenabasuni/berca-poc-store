# Root-owned VM configuration for the fixed storefront deployment rollback demo.
# Copy to /etc/berca-poc/storefront-release.env and set mode 0600. The control
# surface accepts only this GHCR repository and immutable SHA-256 digests.

STOREFRONT_STABLE_IMAGE=ghcr.io/avecenabasuni/berca-storefront@sha256:<STABLE_IMAGE_DIGEST>
STOREFRONT_STABLE_VERSION=stable-<TWELVE_CHARACTER_GIT_SHA>
STOREFRONT_BAD_IMAGE=ghcr.io/avecenabasuni/berca-storefront@sha256:<DEMO_BAD_IMAGE_DIGEST>
STOREFRONT_BAD_VERSION=demo-bad-<TWELVE_CHARACTER_GIT_SHA>
